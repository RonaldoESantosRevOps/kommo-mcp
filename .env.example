# Copie para .env e preencha com a SUA conta. Este arquivo é só um modelo.
# O .env fica fora do Git. Permissão recomendada: chmod 600 .env
#
# Só o rótulo. Se a URL da conta é https://minhaempresa.kommo.com, use minhaempresa.
KOMMO_SUBDOMAIN=minhaempresa

# Token de longa duração, gerado em Configurações → Integrações. Uma linha, sem aspas.
KOMMO_TOKEN=

# 1 bloqueia toda tool que altera dados. kommo_request fica restrito a GET.
KOMMO_READ_ONLY=0

# Intervalo mínimo entre chamadas, em milissegundos. 0 desliga.
# O padrão fica abaixo do teto público de 7 requisições por segundo.
KOMMO_MIN_INTERVAL_MS=200

# Tamanho máximo aceito por kommo_upload_file, em bytes. Padrão: 20 MiB.
KOMMO_UPLOAD_MAX_BYTES=20971520

# 1 omite o e-mail dos usuários em kommo_users e no resource kommo://users.
KOMMO_REDACT_USER_EMAILS=0
