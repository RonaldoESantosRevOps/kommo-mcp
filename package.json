{
  "name": "kommo-mcp",
  "version": "2.1.0",
  "description": "Servidor MCP self-hosted para qualquer conta Kommo (API v4). Cada instalação usa o próprio subdomínio e token; o repositório não traz dados de conta.",
  "type": "module",
  "bin": {
    "kommo-mcp": "index.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    ".env.example",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test tests/unit.test.mjs tests/handlers.test.mjs tests/leak.test.mjs",
    "smoke": "node tests/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kommo",
    "amocrm",
    "crm",
    "cursor",
    "claude"
  ],
  "author": "Ronaldo E. Santos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RonaldoESantosRevOps/kommo-mcp.git"
  },
  "homepage": "https://github.com/RonaldoESantosRevOps/kommo-mcp#readme",
  "bugs": {
    "url": "https://github.com/RonaldoESantosRevOps/kommo-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
